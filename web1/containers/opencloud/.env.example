# Public HTTPS URL handled by external reverse proxy.
OC_URL=https://cloud.example.com
# Required by built-in IDM LDAP; Authentik owns user login.
IDM_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD

# Authentik OAuth2/OIDC provider: public client, ID `web`.
# `offline_access` allows token refresh without a new browser authorization flow.
# Add Strict Authorization redirects:
# https://cloud.example.com/oidc-callback.html
# https://cloud.example.com/oidc-silent-redirect.html
# https://cloud.example.com/
# Set Back-channel logout URI: https://cloud.example.com/backchannel_logout
IDP_DOMAIN=auth.example.com
OC_OIDC_ISSUER=https://auth.example.com/application/o/opencloud/
OC_OIDC_CLIENT_ID=web
OC_OIDC_CLIENT_SCOPES=openid profile email offline_access
WEBFINGER_WEB_OIDC_CLIENT_ID=web
WEBFINGER_WEB_OIDC_CLIENT_SCOPES=openid profile email offline_access

# Keep built-in IDM LDAP for local user state. Authentik replaces built-in IDP.
OC_EXCLUDE_RUN_SERVICES=idp
PROXY_OIDC_ACCESS_TOKEN_VERIFY_METHOD=jwt
PROXY_OIDC_REWRITE_WELLKNOWN=true
# Authentik usernames must be unique and immutable after first OpenCloud login.
PROXY_USER_OIDC_CLAIM=preferred_username
PROXY_USER_CS3_CLAIM=username
PROXY_AUTOPROVISION_ACCOUNTS=true
PROXY_AUTOPROVISION_CLAIM_USERNAME=preferred_username
# Authentik must emit `groups` in access tokens or UserInfo. Role groups:
# opencloudAdmin, opencloudSpaceAdmin, opencloudUser, opencloudGuest.
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=groups
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false
GRAPH_USERNAME_MATCH=none
OC_ADMIN_USER_ID=
SETTINGS_SETUP_DEFAULT_ASSIGNMENTS=false

# Core service only. No additional services or custom apps.
OC_ADD_RUN_SERVICES=
PROXY_HTTP_ADDR=0.0.0.0:9200
PROXY_TLS=false
OC_INSECURE=false
IDM_CREATE_DEMO_USERS=false
PROXY_ENABLE_BASIC_AUTH=false

# Studios04 Web theme. Add custom logo assets under themes/studios04/assets.
WEB_ASSET_THEMES_PATH=/etc/opencloud/themes
WEB_UI_THEME_PATH=themes/studios04/theme.json

# User files use Garage S3. Garage metadata stays in local named volume; only
# Garage object blocks use the mounted Storage Box.
STORAGE_USERS_DRIVER=decomposeds3
STORAGE_SYSTEM_DRIVER=decomposed
STORAGE_USERS_DECOMPOSEDS3_ENDPOINT=http://garage:3900
STORAGE_USERS_DECOMPOSEDS3_REGION=garage
STORAGE_USERS_DECOMPOSEDS3_ACCESS_KEY=GK_CHANGE_ME_TO_A_RANDOM_ACCESS_KEY
STORAGE_USERS_DECOMPOSEDS3_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET
STORAGE_USERS_DECOMPOSEDS3_BUCKET=opencloud
STORAGE_USERS_ID_CACHE_STORE=nats-js-kv

# Stable upstream configuration mounted read-only by Compose.
PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml
OC_PASSWORD_POLICY_BANNED_PASSWORDS_LIST=banned-password-list.txt

# Secure sharing and password policy defaults.
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=true
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=true
OC_PASSWORD_POLICY_DISABLED=false
OC_PASSWORD_POLICY_MIN_CHARACTERS=8
OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_DIGITS=1
OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS=1
