# Garage v2 single-node bootstrap. Access key, secret key, and bucket must
# exactly match STORAGE_USERS_DECOMPOSEDS3_* in OpenCloud .env. Secrets: 64 hex.
GARAGE_DEFAULT_ACCESS_KEY=GK_CHANGE_ME_TO_A_RANDOM_ACCESS_KEY
GARAGE_DEFAULT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET
GARAGE_DEFAULT_BUCKET=opencloud
GARAGE_RPC_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_SECRET
