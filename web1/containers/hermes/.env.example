# Copy this file to .env, chmod 600 .env, replace both empty values.
# Generate them with a cryptographic password/secret generator.
# Hermes credentials and config persist in the hermes_data volume.
# Run `docker compose run --rm gateway setup` once before first deployment.

HERMES_UID=10000
HERMES_GID=10000
HERMES_HOME=/opt/data
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
