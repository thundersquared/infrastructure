#!/usr/bin/env bash
set -u

/usr/local/sbin/check-opencloud-storagebox
status=$?

case "$status" in
  0)
    exit 0
    ;;
  64|65|66)
    # ExecCondition skips start without a restart loop. Operator must fix then restart.
    exit 1
    ;;
  *)
    # ExecStartPre reports transient mount failures so systemd retries the service.
    exit 0
    ;;
esac
