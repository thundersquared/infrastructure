#!/usr/bin/env bash
set -euo pipefail

readonly CONFIG_ERROR=64
readonly UNSAFE_MOUNTPOINT=65
readonly SEMANTICS_ERROR=66
readonly TEMPORARY_FAILURE=75
readonly MOUNTPOINT=/mnt/opencloud
readonly DATA_DIR="$MOUNTPOINT/garage"
readonly MARKER=/var/lib/opencloud/.garage-storagebox-compatibility-passed
readonly REMOTE="${OPENCLOUD_STORAGEBOX_REMOTE:-}"

fail() {
  printf '%s\n' "$1" >&2
  exit "$2"
}

cleanup_probe() {
  local probe_dir=$1
  if [[ -n "$probe_dir" && -d "$probe_dir" ]]; then
    /usr/bin/rm -rf -- "$probe_dir"
  fi
}

verify_mount() {
  local filesystem
  local mount_info
  local source

  if ! mount_info=$(/usr/bin/findmnt --mountpoint "$MOUNTPOINT" --noheadings --output SOURCE,FSTYPE 2>/dev/null); then
    fail "No filesystem mounted at $MOUNTPOINT." "$TEMPORARY_FAILURE"
  fi

  read -r source filesystem <<<"$mount_info"
  if [[ "$filesystem" != cifs ]]; then
    fail "Expected cifs filesystem at $MOUNTPOINT, found $filesystem." "$CONFIG_ERROR"
  fi
  if [[ "$source" != "$REMOTE" ]]; then
    fail "Expected $REMOTE at $MOUNTPOINT, found $source." "$CONFIG_ERROR"
  fi
  if [[ ! -d "$DATA_DIR" ]]; then
    fail "Missing Garage data directory $DATA_DIR." "$CONFIG_ERROR"
  fi
}

run_probe() {
  local probe_dir

  if ! probe_dir=$(mktemp -d "$DATA_DIR/.opencloud-garage-probe.XXXXXX"); then
    fail 'Cannot create Garage Storage Box probe.' "$SEMANTICS_ERROR"
  fi
  trap 'cleanup_probe "$probe_dir"' RETURN

  printf '%s' 'opencloud-garage-storagebox-content' > "$probe_dir/content"
  /usr/bin/sync -f "$probe_dir/content"
  mv "$probe_dir/content" "$probe_dir/renamed-content"
  /usr/bin/sync -f "$probe_dir"
  test "$(cat "$probe_dir/renamed-content")" = 'opencloud-garage-storagebox-content'

  cleanup_probe "$probe_dir"
  trap - RETURN
}

run_persistence_probe() {
  local after_inode
  local before_inode
  local probe_dir
  local running

  running=$(/usr/bin/docker ps -q --filter label=com.docker.compose.project=opencloud)
  if [[ -n "$running" ]]; then
    fail 'OpenCloud or Garage container is running; refusing Storage Box remount.' "$UNSAFE_MOUNTPOINT"
  fi

  if ! probe_dir=$(mktemp -d "$DATA_DIR/.opencloud-garage-persistence.XXXXXX"); then
    fail 'Cannot create Garage Storage Box persistence probe.' "$SEMANTICS_ERROR"
  fi
  trap 'cleanup_probe "$probe_dir"' RETURN EXIT

  printf '%s' 'opencloud-garage-storagebox-persistence' > "$probe_dir/content"
  /usr/bin/sync -f "$probe_dir/content"
  mv "$probe_dir/content" "$probe_dir/renamed-content"
  /usr/bin/sync -f "$probe_dir"
  before_inode=$(/usr/bin/stat -c '%i' "$probe_dir/renamed-content")

  if ! /usr/bin/systemctl restart opencloud-storagebox.service; then
    fail 'Storage Box remount failed.' "$TEMPORARY_FAILURE"
  fi
  verify_mount
  test "$(cat "$probe_dir/renamed-content")" = 'opencloud-garage-storagebox-persistence'
  after_inode=$(/usr/bin/stat -c '%i' "$probe_dir/renamed-content")
  printf 'Garage Storage Box persistence probe passed; inode before=%s after=%s.\n' "$before_inode" "$after_inode"

  cleanup_probe "$probe_dir"
  trap - RETURN EXIT
  /usr/bin/touch "$MARKER"
}

if [[ -z "$REMOTE" ]]; then
  fail 'Missing OPENCLOUD_STORAGEBOX_REMOTE.' "$CONFIG_ERROR"
fi

verify_mount
run_probe

if [[ "${1:-}" == --initialize && ! -e "$MARKER" ]]; then
  run_persistence_probe
fi

printf '%s\n' 'Garage Storage Box compatibility probe passed.'
