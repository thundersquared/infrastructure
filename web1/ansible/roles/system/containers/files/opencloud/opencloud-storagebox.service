[Unit]
Description=Mount OpenCloud Hetzner Storage Box
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/opencloud-storagebox.env
ExecStart=/usr/local/sbin/mount-opencloud-storagebox
ExecStop=/usr/bin/umount /mnt/opencloud
TimeoutStartSec=30
TimeoutStopSec=30
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=64 65

[Install]
WantedBy=multi-user.target
