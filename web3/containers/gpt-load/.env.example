# Create the real .env manually on web3 before deployment. Never commit it.
# GPT-Load uses this file for both Compose interpolation and service settings.

# HTTP server
# HOST is the address GPT-Load listens on inside the container. The host-side
# port mapping is fixed explicitly in docker-compose.yml.
HOST=0.0.0.0
PORT=3000

# Timeouts are seconds; Compose stop grace period uses a duration.
GRACEFUL_SHUTDOWN_TIMEOUT=10
CONTAINER_STOP_GRACE_PERIOD=15s
READ_TIMEOUT=60
IDLE_TIMEOUT=120

# Storage
# Empty DATABASE_DSN uses ${DATA_DIR}/gpt-load.db (SQLite).
DATA_DIR=/app/data
DATABASE_DSN=

# Security
# Empty values generate auth.key and encryption.key in DATA_DIR on first start.
# Back up encryption.key with the database; losing it makes credentials unreadable.
# If set explicitly, use strong values and retain them with the volume backup.
AUTH_KEY=
ENCRYPTION_KEY=

# Startup proxy fallback; restart after changes.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.example.com

# Logging
LOG_LEVEL=info
LOG_FORMAT=text

# Optional process override; omit to use the Models.dev setting (enabled by default).
# MODELS_DEV_AUTO_SYNC_ENABLED=true

# First-run setup: obtain the management key, configure API-key channels,
# groups/model aliases, and client AccessKeys in the GPT-Load UI. Existing
# LiteLLM master keys are control-plane credentials, not GPT-Load AccessKeys,
# and cannot be reused automatically.
