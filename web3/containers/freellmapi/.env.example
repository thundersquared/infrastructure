# Copy this file to .env on web3, chmod 600 .env, and fill in the empty values.
# Never commit it.

# 64-character hex key that encrypts provider API keys at rest. Required in
# production. Generate once with `openssl rand -hex 32` and keep it with the
# freellmapi-data volume backup: losing it makes stored provider keys unreadable.
ENCRYPTION_KEY=

# The container listens on this port; the host-side mapping is in docker-compose.yml.
PORT=3001

# Premium license key from freellmapi.co, applied on every boot (a changed key
# re-activates). Keep the single quotes so the JSON is passed through verbatim.
# Uncomment only with a real key: an empty "license" stops the server booting.
# An "admin" entry ({"email":"...","password":"..."}) may be added to create
# the first dashboard account; otherwise, when reached through a proxy, the
# first-run setup code is printed in the container logs.
# FREEAPI_CONFIG_JSON='{"license":"<freellmapi.co license key>"}'

# Upstream recommends this on hosted installs: custom provider URLs may not
# point at loopback or private network addresses.
FREEAPI_BLOCK_PRIVATE_PROVIDER_URLS=true
