# Keys n8n uses to call the sandbox API (comma-separated). n8n's
# N8N_SANDBOX_SERVICE_API_KEY in .env must be one of them.
SANDBOX_API_KEYS=
# Must match SANDBOX_RUNNER_REGISTRATION_TOKEN in .sandbox-runner.env
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
# Must be one of SANDBOX_RUNNER_API_KEYS in .sandbox-runner.env
SANDBOX_API_RUNNER_API_KEY=
