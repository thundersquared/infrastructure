# Copy this file to .env, config.yaml.example to config.yaml, and
# .postgres.env.example to .postgres.env on web3 before deployment.
# The PostgreSQL password in DATABASE_URL must match POSTGRES_PASSWORD in .postgres.env.

# Required. Generate with: echo "sk-$(openssl rand -hex 32)"
# LiteLLM master keys must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me

# Use a URL-safe password here (for example, generate one with: openssl rand -hex 32).
DATABASE_URL=postgresql://litellm:change-me@postgres:5432/litellm
STORE_MODEL_IN_DB=True

# Add provider credentials here, then add matching model mappings to config.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
