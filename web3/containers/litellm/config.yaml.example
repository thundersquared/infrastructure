---
# Copy this file to config.yaml on the server; retain the runtime copy there.
# Model availability depends on each ChatGPT subscription. Validate all four
# IDs on both workers before sending production traffic through these aliases.
model_list:
  - model_name: gpt-5.6-luna
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-5.6-luna
      api_base: http://chatgpt-account-1:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-5.6-luna
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-5.6-luna
      api_base: http://chatgpt-account-2:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-5.6-terra
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-5.6-terra
      api_base: http://chatgpt-account-1:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-5.6-terra
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-5.6-terra
      api_base: http://chatgpt-account-2:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-5.6-sol
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-5.6-sol
      api_base: http://chatgpt-account-1:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-5.6-sol
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-5.6-sol
      api_base: http://chatgpt-account-2:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-6-astra
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-6-astra
      api_base: http://chatgpt-account-1:4000/v1
      api_key: sk-chatgpt-worker

  - model_name: gpt-6-astra
    model_info:
      mode: responses
    litellm_params:
      model: openai/gpt-6-astra
      api_base: http://chatgpt-account-2:4000/v1
      api_key: sk-chatgpt-worker

litellm_settings:
  telemetry: false
  success_callback:
    - prometheus

router_settings:
  routing_strategy: simple-shuffle
  num_retries: 1

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
