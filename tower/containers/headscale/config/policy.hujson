// Tailnet access policy for tower's Headscale (HuJSON: comments and trailing
// commas are allowed). Checked in CI with `headscale policy check`; a deploy
// that changes this file restarts headscale, which reloads it.
//
// Once any "grants" exist, everything not granted is denied. A node only sees
// the peers it may reach or that may reach it.
//
// People's devices are registered under their own Headscale user; servers
// (the containers/tailscale stack, home servers) under the shared
// "infrastructure" user. The rules below give:
//
//   - every user: their own devices, and the infrastructure nodes
//   - infrastructure nodes: each other (they are all one user, so this is the
//     autogroup:self rule); they cannot open connections to people's devices,
//     but replies to connections those devices open are allowed
//   - nobody: another person's devices
//
// No user names are listed here (the repo is public): autogroup:member is
// every user, so a new user gets the same access as soon as it exists.
//
// Syntax: https://tailscale.com/docs/features/access-control/grants
{
  "grants": [
    // Own devices, for every user, infrastructure included. On v0.29.x,
    // restart headscale after creating or renaming a user, or this rule's
    // filters are not recomputed for them (fixed upstream in #3501, 0.30.0).
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "ip": ["*"],
    },
    // People reach the servers.
    {
      "src": ["autogroup:member"],
      "dst": ["infrastructure@"],
      "ip": ["*"],
    },
    // Exit nodes: once grants exist, using one needs autogroup:internet.
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:internet"],
      "ip": ["*"],
    },
  ],
}
