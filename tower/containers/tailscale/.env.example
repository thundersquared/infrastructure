# Copy to .env on the host and fill in (chmod 600). The stack is deployed
# only while .env exists. See tower/docs/headscale-nodes.md.

# Single-use pre-auth key created on tower. Read only on the first start
# (TS_AUTH_ONCE below); delete the line once the node shows up.
TS_AUTHKEY=

# https:// plus the value of tower's TOWER_HOSTNAME secret. Only applied at
# first login; changing it later needs a re-registration.
TS_EXTRA_ARGS=--login-server=https://<tower-hostname>

# Node name in the tailnet and its MagicDNS label. Empty = the host's hostname.
TS_HOSTNAME=

# Keep the node's identity in ./state across restarts and log in only when
# that state is not logged in yet, so restarts never need the key again.
TS_STATE_DIR=/var/lib/tailscale
TS_AUTH_ONCE=true

# Kernel networking: tailscale0 on the host (needs the TUN device and caps
# in docker-compose.yml).
TS_USERSPACE=false

# The container cannot reach the host's systemd-resolved, so MagicDNS would
# only change the container's own resolv.conf. Use full names or 100.x IPs
# from the host, or install Tailscale on the host instead.
TS_ACCEPT_DNS=false

# /healthz for the compose healthcheck, on the host's loopback.
TS_ENABLE_HEALTH_CHECK=true
TS_LOCAL_ADDR_PORT=127.0.0.1:9002
